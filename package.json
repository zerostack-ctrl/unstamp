{
  "name": "zerostack-ctrl",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "pnpm -r --if-present run bench",
    "typecheck": "tsc -b",
    "dev": "cd apps/web && python3 -m http.server 5173",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "tinybench": "^2.8.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
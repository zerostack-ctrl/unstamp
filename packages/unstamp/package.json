{
  "name": "@zerostack-labc/unstamp",
  "version": "2.0.0",
  "description": "Type-safe watermark detection & removal. Browser + Node.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./detect": {
      "types": "./dist/detect/index.d.ts",
      "import": "./dist/detect/index.js"
    },
    "./mask": {
      "types": "./dist/mask/index.d.ts",
      "import": "./dist/mask/index.js"
    },
    "./inpaint": {
      "types": "./dist/inpaint/index.d.ts",
      "import": "./dist/inpaint/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "bench": "node bench/index.js"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.18.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    }
  },
  "keywords": [
    "watermark",
    "inpaint",
    "onnx",
    "image",
    "vision",
    "typescript",
    "browser",
    "node",
    "c2pa",
    "exif"
  ]
}
